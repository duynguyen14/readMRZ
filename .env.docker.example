# Copy these values into .env on the Docker host, or keep them in a separate
# env file and pass it to docker compose. Secrets are intentionally blank here.

READMRZ_API_HOST=0.0.0.0
READMRZ_API_PORT=8080
READMRZ_HOST_PORT=8080
READMRZ_API_KEY=

# SQL Server from inside the container.
READMRZ_DB_DRIVER=ODBC Driver 18 for SQL Server
READMRZ_DB_SERVER=192.168.10.242
READMRZ_DB_DATABASE=HOCHIEU
READMRZ_DB_TRUSTED_CONNECTION=false
READMRZ_DB_TRUST_SERVER_CERTIFICATE=true
READMRZ_DB_USERNAME=sa
READMRZ_DB_PASSWORD=

# CPU-only runtime, same as dev.
READMRZ_API_PRELOAD_MODELS=true
READMRZ_API_WARMUP_MODELS=true
READMRZ_API_INFERENCE_CONCURRENCY=1
READMRZ_API_QUEUE_TIMEOUT_SECONDS=120
READMRZ_API_MAX_HTTP_THREADS=8
READMRZ_API_MAX_REQUEST_BYTES=104857600
READMRZ_INFERENCE_MAX_IMAGE_SIDE=1600
READMRZ_BATCH_MAX_ITEMS=20
READMRZ_OPENCV_CPU_THREADS=2
READMRZ_YOLO_CPU_THREADS=8
READMRZ_ORIENTATION_CPU_THREADS=2
READMRZ_CUSTOM_OCR_CPU_THREADS=4

# Host folders mounted into the container by docker-compose.yml.
READMRZ_DOCKER_MODELS_DIR=./models
READMRZ_DOCKER_GENERATED_DATASETS_DIR=./generated_datasets
READMRZ_DOCKER_IMAGES_DIR=./images
READMRZ_DOCKER_VN_VISA_INPUT_DIR=./vn_visa_input
READMRZ_DOCKER_VN_VISA_ORIENTED_DIR=./vn_visa_oriented
READMRZ_DOCKER_VN_VISA_COLAB_EXPORT_DIR=./vn_visa_colab_export

# Model paths inside the container. These are normally overridden by compose,
# but keeping them here makes the runtime explicit.
READMRZ_YOLO_DEVICE=cpu
READMRZ_YOLO_MODEL_PATH=/app/models/mrz_yolo11n_best.pt
READMRZ_CUSTOM_OCR_ENABLED=true
READMRZ_CUSTOM_OCR_DEVICE=cpu
READMRZ_CUSTOM_OCR_MODEL_DIR=/app/models/mrz_ocr_ctc
READMRZ_CUSTOM_OCR_DICT_PATH=/app/models/mrz_ocr_ctc/mrz_dict.txt
READMRZ_FILE_DETECT_MODEL_PATH=/app/models/file_type_classifier
READMRZ_FILE_DETECT_METADATA_PATH=
READMRZ_FILE_DETECT_PRELOAD=true
READMRZ_FILE_DETECT_WARMUP=true
READMRZ_FILE_DETECT_CPU_THREADS=4
READMRZ_FILE_DETECT_MIN_CONF=0.0

# Paddle orientation/OCR models inside the container.
OCR_LANGUAGE=en
PADDLE_OCR_VERSION=PP-OCRv5
PADDLE_OCR_DEVICE=cpu
PADDLE_PDX_MODEL_SOURCE=BOS
PADDLE_USE_DOC_ORIENTATION_CLASSIFY=true
PADDLE_USE_TEXTLINE_ORIENTATION=true
PADDLE_DOC_ORIENTATION_MODEL_DIR=/app/models/PP-LCNet_x1_0_doc_ori
PADDLE_TEXTLINE_ORIENTATION_MODEL_DIR=/app/models/PP-LCNet_x1_0_textline_ori
PADDLE_TEXT_DETECTION_MODEL_DIR=/app/models/paddle/PP-OCRv5_server_det
PADDLE_TEXT_RECOGNITION_MODEL_DIR=/app/models/paddle/en_PP-OCRv5_mobile_rec
READMRZ_PADDLE_PYTHON=

# InsightFace SCRFD + ArcFace CPU.
READMRZ_FACE_MATCH_PRELOAD=true
READMRZ_FACE_MATCH_WARMUP=true
INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_MODEL_ROOT=/app/models/insightface
INSIGHTFACE_PROVIDERS=CPUExecutionProvider
INSIGHTFACE_CTX_ID=-1
FACE_MATCH_PREFER_CUDA=false
INSIGHTFACE_DET_WIDTH=640
INSIGHTFACE_DET_HEIGHT=640
INSIGHTFACE_DETECT_SCORE_THRESHOLD=0.5
READMRZ_FACE_MATCH_MAX_DETECTIONS_PER_IMAGE=5
INSIGHTFACE_MATCH_THRESHOLD=0.45
INSIGHTFACE_REVIEW_THRESHOLD=0.35

# VN visa review/import paths inside the container.
READMRZ_VN_VISA_INPUT_DIR=/app/vn_visa_input
READMRZ_VN_VISA_OUTPUT_DIR=/app/vn_visa_oriented
READMRZ_VN_VISA_IMPORT_ROOT=/app/vn_visa_colab_export
READMRZ_VN_VISA_IMPORT_OCR_RESULTS_DIR=/app/vn_visa_colab_export/ocr_results
READMRZ_VN_VISA_IMPORT_ORIENTED_IMAGE_DIR=/app/vn_visa_colab_export/oriented_images
READMRZ_VN_VISA_DOCUMENT_TYPE=loose_visa_vn
READMRZ_VN_VISA_IMPORT_BATCH_SIZE=200
