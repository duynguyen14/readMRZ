# Folder containing original passport/visa images.
READMRZ_SOURCE_IMAGE_DIR=D:/DocHochieu/images

# API bind config. Use 0.0.0.0 to allow LAN clients.
READMRZ_API_HOST=0.0.0.0
READMRZ_API_PORT=8080

# SQL Server config for label review DB.
READMRZ_DB_DRIVER=ODBC Driver 17 for SQL Server
READMRZ_DB_SERVER=192.168.10.245
READMRZ_DB_DATABASE=db_dichvu_visa
READMRZ_DB_TRUSTED_CONNECTION=false
READMRZ_DB_TRUST_SERVER_CERTIFICATE=true
READMRZ_DB_USERNAME=
READMRZ_DB_PASSWORD=
READMRZ_DB_IMPORT_BATCH_SIZE=500

# Output YOLO dataset folder. This folder will contain images/, labels/, review/, data.yaml, processed.json.
READMRZ_YOLO_DATASET_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_yolo
READMRZ_YOLO_IMAGE_BASE_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_yolo/images
READMRZ_YOLO_LABEL_BASE_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_yolo/labels

# OCR engine: paddle or rapidocr. Paddle is recommended for pseudo-label quality.
READMRZ_OCR_ENGINE=paddle

# Optional: if PaddleOCR is installed in another venv, the script will re-run itself with this Python.
READMRZ_PADDLE_PYTHON=D:/DocHochieu/Backend/.venv/Scripts/python.exe

# PaddleOCR v5 model folders.
OCR_LANGUAGE=en
PADDLE_OCR_VERSION=PP-OCRv5
PADDLE_OCR_DEVICE=cpu
PADDLE_PDX_MODEL_SOURCE=BOS
PADDLE_USE_DOC_ORIENTATION_CLASSIFY=true
PADDLE_USE_TEXTLINE_ORIENTATION=true
PADDLE_DOC_ORIENTATION_MODEL_DIR=C:/Users/Admin/.paddlex/official_models/PP-LCNet_x1_0_doc_ori
PADDLE_TEXTLINE_ORIENTATION_MODEL_DIR=C:/Users/Admin/.paddlex/official_models/PP-LCNet_x1_0_textline_ori
PADDLE_TEXT_DETECTION_MODEL_DIR=D:/DocHochieu/Backend/models/paddle/PP-OCRv5_server_det
PADDLE_TEXT_RECOGNITION_MODEL_DIR=D:/DocHochieu/Backend/models/paddle/en_PP-OCRv5_mobile_rec

# Optional RapidOCR ONNX model paths. Used only when READMRZ_OCR_ENGINE=rapidocr.
READMRZ_DET_MODEL_PATH=
READMRZ_REC_MODEL_PATH=
READMRZ_CLS_MODEL_PATH=

# Pseudo-label thresholds.
READMRZ_MIN_OCR_SCORE=0.35
READMRZ_MIN_MRZ_LIKENESS=0.48
READMRZ_MIN_MRZ_LINE_LENGTH=24
READMRZ_VAL_RATIO=0.1
READMRZ_TEST_RATIO=0.0
READMRZ_PROCESSED_BATCH_SIZE=25
