# Folder containing original passport/visa images.
READMRZ_SOURCE_IMAGE_DIR=D:/DocHochieu/images

# API bind config. Use 0.0.0.0 to allow LAN clients.
READMRZ_API_HOST=0.0.0.0
READMRZ_API_PORT=8080
# Load Paddle orientation, YOLO and custom CTC before the API starts listening.
READMRZ_API_PRELOAD_MODELS=true
# Run one dummy inference per model during startup to remove first-request initialization cost.
READMRZ_API_WARMUP_MODELS=true
# API key for protected integration endpoints. PASSPORT_INFERENCE_API_KEY/API_KEY are also accepted.
READMRZ_API_KEY=
# Keep this low on CPU-only servers; extra requests wait instead of running heavy models at once.
READMRZ_API_INFERENCE_CONCURRENCY=1
READMRZ_API_QUEUE_TIMEOUT_SECONDS=120
READMRZ_API_MAX_HTTP_THREADS=8
READMRZ_API_MAX_REQUEST_BYTES=52428800
# Resize only the working image sent into models. API responses still return the original base64.
READMRZ_INFERENCE_MAX_IMAGE_SIDE=1600
# Max images accepted by the many-to-many face/passport endpoint.
READMRZ_BATCH_MAX_ITEMS=20
READMRZ_OPENCV_CPU_THREADS=2

# File/document type classifier. READMRZ_FILE_DETECT_MODEL_PATH can be either
# the package folder or the model.onnx file. metadata.json is auto-read next to model.onnx.
READMRZ_FILE_DETECT_MODEL_PATH=C:/Users/Administrator/Downloads/DocHoChieu/readMRZ/model/file_type_classifier/mobilenetv3_small_document_4class_v1
READMRZ_FILE_DETECT_METADATA_PATH=
READMRZ_FILE_DETECT_PRELOAD=true
READMRZ_FILE_DETECT_WARMUP=true
READMRZ_FILE_DETECT_CPU_THREADS=4
READMRZ_FILE_DETECT_MIN_CONF=0.0

# InsightFace face matching. The model pack uses SCRFD for detection and ArcFace for recognition.
READMRZ_FACE_MATCH_PRELOAD=false
READMRZ_FACE_MATCH_WARMUP=false
INSIGHTFACE_MODEL_NAME=buffalo_l
# FaceAnalysis expects the actual pack at: INSIGHTFACE_MODEL_ROOT/models/<INSIGHTFACE_MODEL_NAME>/
INSIGHTFACE_MODEL_ROOT=D:/Project Real/READMRZ/models/insightface
INSIGHTFACE_PROVIDERS=CPUExecutionProvider
INSIGHTFACE_CTX_ID=-1
FACE_MATCH_PREFER_CUDA=false
INSIGHTFACE_DET_WIDTH=640
INSIGHTFACE_DET_HEIGHT=640
INSIGHTFACE_DETECT_SCORE_THRESHOLD=0.5
READMRZ_FACE_MATCH_MAX_DETECTIONS_PER_IMAGE=5
INSIGHTFACE_MATCH_THRESHOLD=0.45
INSIGHTFACE_REVIEW_THRESHOLD=0.35

# SQL Server config for label review DB.
READMRZ_DB_DRIVER=ODBC Driver 17 for SQL Server
READMRZ_DB_SERVER=192.168.10.245
READMRZ_DB_DATABASE=db_dichvu_visa
READMRZ_DB_TRUSTED_CONNECTION=false
READMRZ_DB_TRUST_SERVER_CERTIFICATE=true
READMRZ_DB_USERNAME=
READMRZ_DB_PASSWORD=
READMRZ_DB_IMPORT_BATCH_SIZE=500

# Output YOLO dataset folder. This folder will contain images/, labels/, review/, data.yaml, processed.json.
READMRZ_YOLO_DATASET_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_yolo
READMRZ_YOLO_IMAGE_BASE_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_yolo/images
READMRZ_YOLO_LABEL_BASE_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_yolo/labels
READMRZ_YOLO_MODEL_PATH=D:/Project Real/READMRZ/models/mrz_yolo11n_best.pt
READMRZ_YOLO_IMGSZ=640
READMRZ_YOLO_CONF=0.25
READMRZ_YOLO_DEVICE=cpu
READMRZ_YOLO_CPU_THREADS=8
READMRZ_YOLO_ROTATION_FALLBACK=true
READMRZ_YOLO_ROTATION_FALLBACK_MIN_CONF=0.85
# Normalize document orientation with Paddle before YOLO inference.
READMRZ_YOLO_PADDLE_ORIENTATION=true
READMRZ_YOLO_PADDLE_ORIENTATION_MIN_CONF=0.50
READMRZ_ORIENTATION_CPU_THREADS=2

# Custom CTC recognizer used after the YOLO MRZ box is split into lines.
READMRZ_CUSTOM_OCR_ENABLED=true
READMRZ_CUSTOM_OCR_MODEL_DIR=C:/Users/Administrator/Downloads/DocHoChieu/readMRZ/model/mrz_ocr_ctc
READMRZ_CUSTOM_OCR_DICT_PATH=C:/Users/Administrator/Downloads/DocHoChieu/readMRZ/model/mrz_ocr_ctc/mrz_dict.txt
READMRZ_CUSTOM_OCR_DEVICE=cpu
READMRZ_CUSTOM_OCR_BATCH_SIZE=2
READMRZ_CUSTOM_OCR_MIN_CONF=0.0
READMRZ_CUSTOM_OCR_CPU_THREADS=4
READMRZ_CUSTOM_OCR_GPU_MEMORY_MB=500
# Keep disabled on Windows/Paddle 3.x; the memory_optimize_pass can fail when
# orientation and custom OCR predictors coexist in one process.
READMRZ_CUSTOM_OCR_MEMORY_OPTIM=false

# Retry OCR only when the fast crop cannot parse a checksum-valid MRZ.
READMRZ_OCR_FALLBACK_ENABLED=true
READMRZ_OCR_FALLBACK_MAX_CANDIDATES=4
READMRZ_OCR_FALLBACK_DESKEW_OFFSETS=-2,2
READMRZ_OCR_FALLBACK_LINE_OVERLAP_RATIO=0.10
READMRZ_OCR_FALLBACK_LINE_PADDING_RATIO=0.05
READMRZ_OCR_FALLBACK_TEXT_CORRECTION=true
READMRZ_OCR_FALLBACK_CLAHE=true
READMRZ_YOLO_AUG_SEED=20260731
READMRZ_YOLO_AUG_ROT90_TRAIN_LIMIT=3000
READMRZ_YOLO_AUG_ROT270_TRAIN_LIMIT=3000
READMRZ_YOLO_AUG_ROT180_TRAIN_LIMIT=1800
READMRZ_YOLO_AUG_VAL_ROTATIONS=90,180,270
READMRZ_YOLO_AUG_INCLUDE_AUGMENTED=false
READMRZ_YOLO_AUG_DB_BATCH_SIZE=250

# Output OCR line dataset generated from approved MRZ boxes.
READMRZ_OCR_LINE_DATASET_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_ocr_lines
READMRZ_OCR_LINE_IMAGE_BASE_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_ocr_lines/images
READMRZ_OCR_LINE_BATCH_SIZE=25
READMRZ_OCR_LINE_MRZ_PADDING_RATIO=0.06
READMRZ_OCR_LINE_PADDING_RATIO=0.08
READMRZ_OCR_LINE_MIN_MRZ_LIKENESS=0.35
READMRZ_OCR_LINE_MIN_TEXT_LENGTH=20
READMRZ_OCR_LINE_FALLBACK_LINES=2
READMRZ_OCR_LINE_NORMALIZE_ORIENTATION=true

# Output OCR line dataset v2: OpenCV deskew + horizontal projection + PaddleOCR line text.
READMRZ_OCR_LINE2_DATASET_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_ocr_lines2
READMRZ_OCR_LINE2_IMAGE_BASE_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_ocr_lines2/images
READMRZ_OCR_LINE2_CROP_BASE_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_ocr_lines2/crops
READMRZ_OCR_LINE2_RAW_CROP_BASE_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_ocr_lines2/raw_crops
READMRZ_OCR_LINE2_BATCH_SIZE=25
READMRZ_OCR_LINE2_MRZ_PADDING_RATIO=0.08
READMRZ_OCR_LINE2_LINE_PADDING_RATIO=0.06
READMRZ_OCR_LINE2_DILATE_KERNEL_WIDTH=35
READMRZ_OCR_LINE2_DILATE_KERNEL_HEIGHT=3
READMRZ_OCR_LINE2_PROJECTION_THRESHOLD_RATIO=0.12
READMRZ_OCR_LINE2_MIN_BAND_HEIGHT=6
READMRZ_OCR_LINE2_EXPECTED_LINES=2
READMRZ_OCR_LINE2_MAX_DESKEW_ANGLE=15
READMRZ_OCR_LINE2_TRIM_X=false
READMRZ_OCR_LINE2_TRIM_X_THRESHOLD_RATIO=0.08
READMRZ_OCR_LINE2_TRIM_X_PADDING_RATIO=0.02

# TransactionEVisa source for OCR line dataset v3.
# If READMRZ_EVISA_SOURCE_CONNECTION_STRING is blank, the script reads SourceConnectionString
# and SourceRootDirectory from the C# tool application.json below.
READMRZ_EVISA_APPLICATION_JSON=D:/DocHochieu/ToolCheckDuLieu/Check/CheckduLieu/application.json
READMRZ_EVISA_SOURCE_CONNECTION_STRING=
READMRZ_EVISA_SOURCE_ROOT_DIR=
READMRZ_EVISA_SOURCE_DB_DRIVER=ODBC Driver 17 for SQL Server
READMRZ_EVISA_SOURCE_DB_SERVER=
READMRZ_EVISA_SOURCE_DB_DATABASE=db_dichvu_visa
READMRZ_EVISA_SOURCE_DB_TRUSTED_CONNECTION=false
READMRZ_EVISA_SOURCE_DB_TRUST_SERVER_CERTIFICATE=true
READMRZ_EVISA_SOURCE_DB_USERNAME=
READMRZ_EVISA_SOURCE_DB_PASSWORD=

# Output OCR line dataset v3: TransactionEVisa MRZ text + YOLO MRZ crop.
READMRZ_EVISA_LINE3_DATASET_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_ocr_lines3
READMRZ_EVISA_LINE3_IMAGE_BASE_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_ocr_lines3/images
READMRZ_EVISA_LINE3_CROP_BASE_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_ocr_lines3/crops
READMRZ_EVISA_LINE3_RAW_CROP_BASE_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_ocr_lines3/raw_crops
READMRZ_EVISA_LINE3_BATCH_SIZE=25
READMRZ_EVISA_LINE3_VERTICAL_BOX_RATIO=1.15
READMRZ_EVISA_LINE3_VERTICAL_ROTATE_DIRECTION=cw
READMRZ_EVISA_LINE3_AUTO_ROTATE_180=true
READMRZ_EVISA_LINE3_180_MIN_COMPONENTS=6
READMRZ_EVISA_LINE3_180_MIN_SCORE_DELTA=0.50
READMRZ_EVISA_LINE3_FINAL_DATASET_DIR=D:/Project Real/READMRZ/generated_datasets/mrz_ocr_lines3_final
READMRZ_EVISA_LINE3_FINAL_PRESERVE_SPLIT=true
READMRZ_EVISA_LINE3_FINAL_EXPORT_BATCH_SIZE=500

# Output folder for batch pipeline QA from TransactionEVisa source rows.
READMRZ_PIPELINE_TEST_OUTPUT_DIR=D:/Project Real/READMRZ/generated_datasets/pipeline_tests

# Output dataset for image type classifier: passport page vs face crop.
READMRZ_IMAGE_TYPE_DATASET_DIR=D:/Project Real/READMRZ/generated_datasets/image_type_classifier
READMRZ_IMAGE_TYPE_IMAGE_BASE_DIR=D:/Project Real/READMRZ/generated_datasets/image_type_classifier/images
READMRZ_IMAGE_TYPE_VAL_RATIO=0.1
READMRZ_IMAGE_TYPE_TEST_RATIO=0.0
READMRZ_IMAGE_TYPE_SPLIT_SEED=20260805
READMRZ_IMAGE_TYPE_BATCH_SIZE=200
READMRZ_IMAGE_TYPE_PDF_RENDER_ZOOM=2.0

# OCR engine: paddle or rapidocr. Paddle is recommended for pseudo-label quality.
READMRZ_OCR_ENGINE=paddle

# Optional: if PaddleOCR is installed in another venv, the script will re-run itself with this Python.
READMRZ_PADDLE_PYTHON=D:/DocHochieu/Backend/.venv/Scripts/python.exe

# PaddleOCR v5 model folders.
OCR_LANGUAGE=en
PADDLE_OCR_VERSION=PP-OCRv5
PADDLE_OCR_DEVICE=cpu
PADDLE_PDX_MODEL_SOURCE=BOS
PADDLE_USE_DOC_ORIENTATION_CLASSIFY=true
PADDLE_USE_TEXTLINE_ORIENTATION=true
PADDLE_DOC_ORIENTATION_MODEL_DIR=C:/Users/Admin/.paddlex/official_models/PP-LCNet_x1_0_doc_ori
PADDLE_TEXTLINE_ORIENTATION_MODEL_DIR=C:/Users/Admin/.paddlex/official_models/PP-LCNet_x1_0_textline_ori
PADDLE_TEXT_DETECTION_MODEL_DIR=C:/Users/Administrator/Downloads/DocHoChieu/backend/backendhochieu/models/paddle/PP-OCRv5_server_det
PADDLE_TEXT_RECOGNITION_MODEL_DIR=C:/Users/Administrator/Downloads/DocHoChieu/backend/backendhochieu/models/paddle/en_PP-OCRv5_mobile_rec

# Optional RapidOCR ONNX model paths. Used only when READMRZ_OCR_ENGINE=rapidocr.
READMRZ_DET_MODEL_PATH=
READMRZ_REC_MODEL_PATH=
READMRZ_CLS_MODEL_PATH=

# Pseudo-label thresholds.
READMRZ_MIN_OCR_SCORE=0.35
READMRZ_MIN_MRZ_LIKENESS=0.48
READMRZ_MIN_MRZ_LINE_LENGTH=24
READMRZ_VAL_RATIO=0.1
READMRZ_TEST_RATIO=0.0
READMRZ_PROCESSED_BATCH_SIZE=25

# Vietnam visa OCR dataset import. Paths saved to DB are relative to these roots:
# RelativeImagePath is relative to READMRZ_VN_VISA_INPUT_DIR.
# OrientedRelativeImagePath is relative to READMRZ_VN_VISA_OUTPUT_DIR.
READMRZ_VN_VISA_INPUT_DIR=D:/DocHochieu/vn_visa_input
READMRZ_VN_VISA_OUTPUT_DIR=D:/DocHochieu/vn_visa_oriented
READMRZ_VN_VISA_DOCUMENT_TYPE=visa_sticker_vn
READMRZ_VN_VISA_BATCH_SIZE=50
READMRZ_VN_VISA_MAX_IMAGE_SIDE=1600
READMRZ_VN_VISA_LIMIT=0
READMRZ_VN_VISA_OVERWRITE=false
READMRZ_VN_VISA_REPROCESS_ERRORS=false
READMRZ_VN_VISA_EXTENSIONS=.jpg,.jpeg,.png,.bmp,.tif,.tiff,.webp
READMRZ_VN_VISA_MIN_OCR_SCORE=0.20
READMRZ_VN_VISA_REGEX_VERSION=vn_visa_regex_v1
READMRZ_VN_VISA_AUTO_MAPPING_VERSION=ocr_bbox_auto_v1
READMRZ_VN_VISA_PADDLE_DOC_ORIENTATION_IN_OCR=false
READMRZ_VN_VISA_PADDLE_DOC_UNWARPING=false
PADDLE_TEXT_DET_LIMIT_SIDE_LEN=1280
